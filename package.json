{
    "name": "monorepo_boilerplate",
    "version": "1.0.0",
    "description": "A Boilerplate Monorepo for Javascript Full Stack Development",
    "packageManager": "pnpm@12.14.0",
    "scripts": {
        "frontend-start": "pnpm --filter frontend dev",
        "format": "prettier --check .",
        "format:fix": "prettier --write --list-different .",
        "lint": "pnpm -r lint",
        "typecheck": "pnpm -r typecheck",
        "test": "pnpm -r test",
        "test:integration": "pnpm -r test:integration",
        "deps:audit": "pnpm audit --audit-level high",
        "build": "pnpm -r build"
    },
    "engines": {
        "node": ">=26",
        "pnpm": ">=12"
    },
    "author": "Zuguang Tong",
    "license": "MIT",
    "devDependencies": {
        "prettier": "^3.9.10"
    }
}
