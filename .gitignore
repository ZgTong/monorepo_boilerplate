node_modules/
.next/
dist/
.swc/
*.tsbuildinfo
.*.env

# Claude Code per-user settings (and the temp files it writes while saving them);
# team-wide settings belong in .claude/settings.json
.claude/settings.local.json*

# Environment files (commit only the *.example templates)
.env
.env.*
!.env.example

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
# Partial backend config (*.<backend>.tfbackend, the naming Terraform recommends); commit only the .example.
*.tfbackend
# Saved plans (terraform plan -out=...) can contain resource attributes; never commit them.
*.tfplan
# Output of `terraform plan -generate-config-out`; review and move into real files.
generated.tf
